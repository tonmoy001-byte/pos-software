generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Store {
  id                String             @id @default(uuid())
  name              String
  address           String?
  phone             String?
  email             String?
  description       String?
  logo              String?
  invoicePrefix     String             @default("INV")
  invoiceNumbering  Int                @default(1)
  invoiceFooter     String?
  taxId             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  barcodeSettings   BarcodeSettings?
  customers         Customer[]
  dailyBalances     DailyBalance[]
  events            Event[]
  expenses          Expense[]
  invoiceSettings   InvoiceSettings?
  loans             Loan[]
  products          Product[]
  sales             Sale[]
  secondHandRecords SecondHandRecord[]
  suppliers         Supplier[]
  transactions      Transaction[]
  users             User[]
}

model InvoiceSettings {
  id        String   @id @default(uuid())
  storeId   String   @unique
  general   String   @default("{}")
  layout    String   @default("{}")
  products  String   @default("{}")
  payment   String   @default("{}")
  footer    String   @default("{}")
  print     String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(CASHIER)
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])
}

model Product {
  id        String           @id @default(uuid())
  name      String
  barcode   String?          @unique
  model     String
  brand     String
  category  String
  price     Decimal
  cost      Decimal
  profit    Decimal          @default(0)
  stock    Int              @default(0)
  minStock  Int              @default(5)
  storage   String?
  color    String?
  imei     String?
  warranty Int?
  storeId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  store     Store            @relation(fields: [storeId], references: [id])
  saleItems SaleItem[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  address   String?
  dueAmount Decimal  @default(0)
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])
  sales     Sale[]
}

model Sale {
  id               String     @id @default(uuid())
  invoiceId        String     @unique
  saleType         String     @default("REGULAR")
  totalAmount      Decimal
  paidAmount       Decimal
  dueAmount        Decimal
  discount         Decimal    @default(0)
  costAmount       Decimal    @default(0)
  profit           Decimal    @default(0)
  status           SaleStatus
  customerId       String?
  customerName     String?    @default("Walking Customer")
  storeId          String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deliveryDate     DateTime?
  advanceAmount    Decimal?   // Advance paid amount for advance orders
  payments         Payment[]
  store            Store      @relation(fields: [storeId], references: [id])
  customer         Customer?  @relation(fields: [customerId], references: [id])
  items            SaleItem[]
}

model SaleItem {
  id        String           @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Decimal
  cost      Decimal?
  profit    Decimal          @default(0)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(uuid())
  amount    Decimal
  method    String
  date      DateTime @default(now())
  saleId    String
  storeId   String
  createdAt DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  category    String
  date        DateTime @default(now())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
}

model Loan {
  id           String        @id @default(uuid())
  borrower     String
  type         String
  amount       Decimal
  paid         Decimal       @default(0)
  remaining    Decimal
  date         DateTime      @default(now())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])
  transactions Transaction[]
}

model Supplier {
  id            String              @id @default(uuid())
  name          String
  phone         String?
  address      String?
  dueAmount    Decimal             @default(0)
  storeId      String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  store        Store               @relation(fields: [storeId], references: [id])
  transactions Transaction[]
  products     SupplierProduct[]
}

model SupplierProduct {
  id           String   @id @default(uuid())
  supplierId  String
  productId  String?
  productName String  // For existing products or custom names
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  
  @@unique([supplierId, productName])
}

model DailyBalance {
  id            String   @id @default(uuid())
  date          DateTime @unique
  openingCash   Decimal  @default(0)
  closingCash   Decimal  @default(0)
  expectedCash  Decimal  @default(0)
  cashSales     Decimal  @default(0)
  bankDeposits  Decimal  @default(0)
  totalExpenses Decimal  @default(0)
  totalDuePaid  Decimal  @default(0)
  storeId       String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

model Event {
  id            String   @id @default(uuid())
  aggregateType String
  aggregateId   String
  type          String
  payload       String
  metadata      String?
  userId        String?
  storeId       String
  createdAt     DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id])

  @@unique([aggregateType, aggregateId, createdAt])
  @@index([storeId, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model Transaction {
  id            String            @id @default(uuid())
  type          TransactionType
  amount        Decimal
  costAmount    Decimal?
  profit        Decimal           @default(0)
  mode          TransactionMode   @default(CASH)
  referenceId   String?
  referenceType String?
  description   String?
  barcode       String?
  productId     String?
  customerId    String?
  supplierId    String?
  userId        String?
  storeId       String
  loanId        String?
  createdAt     DateTime          @default(now())
  status        TransactionStatus @default(COMPLETED)
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  loan          Loan?             @relation(fields: [loanId], references: [id])
  store         Store             @relation(fields: [storeId], references: [id])

  @@index([storeId, type, createdAt])
  @@index([storeId, createdAt])
  @@index([barcode])
}

model SecondHandRecord {
  id            String   @id @default(uuid())
  sellerName    String
  fatherName    String?
  nidNumber     String
  nidPhotoData  Bytes?
  nidPhotoHash  String?
  model         String
  purchasePrice Decimal
  date          DateTime @default(now())
  storeId       String
  isImmutable   Boolean  @default(true)
  encryptionIv  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id])
}

model BarcodeSettings {
  id              String   @id @default(uuid())
  storeId         String   @unique
  barcodeType     String   @default("CODE128")
  labelWidth      Int      @default(38)
  labelHeight     Int      @default(25)
  labelSizeName   String   @default("38x25mm")
  showProductName Boolean  @default(true)
  showPrice       Boolean  @default(true)
  showSku         Boolean  @default(true)
  showBarcode     Boolean  @default(true)
  showQrCode      Boolean  @default(false)
  showWarranty    Boolean  @default(false)
  includeCurrency Boolean  @default(true)
  fontSize        Int      @default(8)
  compactMode     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id])
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum SaleStatus {
  PAID
  PARTIAL
  DUE
  PENDING   // For advance orders
  COMPLETED // For advance orders
  CANCELLED
}

enum SaleType {
  REGULAR
  ADVANCE_ORDER
}

enum TransactionType {
  SALE
  SALE_REFUND
  PURCHASE
  PURCHASE_RETURN
  DUE_PAYMENT
  HAWLAT_GIVEN
  HAWLAT_RECEIVED
  EXPENSE
  STOCK_IN
  SECONDHAND_BUY
  OPENING
  CLOSING
}

enum TransactionMode {
  CASH
  BANK
  BKASH
  NAGAD
  CARD
  DUE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}
