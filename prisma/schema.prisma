generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  customers Customer[]
  products  Product[]
  users     User[]
  transactions Transaction[]
  expenses  Expense[]
  loans     Loan[]
  secondHandRecords SecondHandRecord[]

  @@unique([name, storeId])
  @@index([storeId])
}

model Plan {
  id               String                 @id @default(uuid())
  name             String                 @unique
  displayName      String
  maxProducts      Int                    @default(100)
  maxUsers         Int                    @default(3)
  maxBranches      Int                    @default(1)
  features         String                 @default("[]")
  priceMonthly     Int                    @default(0)
  priceYearly      Int                    @default(0)
  trialDays        Int                    @default(14)
  isCustomPricing  Boolean                @default(false)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  subscriptions    Subscription[]
  currentPlanRequests   SubscriptionRequest[] @relation("CurrentPlanRequests")
  requestedPlanRequests SubscriptionRequest[] @relation("RequestedPlanRequests")
}

model Subscription {
  id                 String               @id @default(uuid())
  storeId            String               @unique
  planId             String
  status             SubscriptionStatus   @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  subscriptionPrice  Int?                 // purchased price snapshot
  billingCycle       BillingCycle?        // MONTHLY or YEARLY
  gracePeriodEnds    DateTime?            // 3-day read-only after expiry
  last30DayWarningAt DateTime?
  last7DayWarningAt  DateTime?
  last3DayWarningAt  DateTime?
  last1DayWarningAt  DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  store              Store                @relation(fields: [storeId], references: [id])
  plan               Plan                 @relation(fields: [planId], references: [id])

  @@index([storeId])
  @@index([planId])
  @@index([status])
}

model SubscriptionRequest {
  id                String                    @id @default(uuid())
  storeId           String
  currentPlanId     String
  requestedPlanId   String
  status            SubscriptionRequestStatus @default(PENDING)
  billingCycle      BillingCycle?
  paymentMethod     String?
  transactionId     String?
  amountPaid        Decimal?
  notes             String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  store             Store                     @relation(fields: [storeId], references: [id])
  currentPlan       Plan                      @relation("CurrentPlanRequests", fields: [currentPlanId], references: [id])
  requestedPlan     Plan                      @relation("RequestedPlanRequests", fields: [requestedPlanId], references: [id])

  @@index([storeId])
  @@index([status])
}

model SubscriptionAuditLog {
  id              String                   @id @default(uuid())
  storeId         String
  subscriptionId  String?
  action          SubscriptionAuditAction
  previousStatus  SubscriptionStatus?
  newStatus       SubscriptionStatus?
  previousPlanId  String?
  newPlanId       String?
  performedBy     String
  performedByType String
  notes           String?
  createdAt       DateTime                 @default(now())
  store           Store                    @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([subscriptionId])
}

model Notification {
  id        String           @id @default(uuid())
  storeId   String
  userId    String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  store     Store            @relation(fields: [storeId], references: [id])

  @@index([storeId, isRead])
  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  payload   String
  createdAt DateTime @default(now())

  @@index([email])
}

model Store {
  id                  String             @id @default(uuid())
  name                String
  address             String?
  phone               String?
  email               String?
  description         String?
  logo                String?
  status              String             @default("active")
  businessType        String?
  onboardingComplete  Boolean            @default(false)
  suspendedAt         DateTime?
  suspendedBy         String?
  suspendedReason     String?
  invoicePrefix       String             @default("INV")
  invoiceCode         String             @default("")
  invoiceNumbering    Int                @default(1)
  invoiceFooter       String?
  taxId               String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  barcodeSettings     BarcodeSettings?
  customers           Customer[]
  dailyBalances       DailyBalance[]
  events              Event[]
  expenses            Expense[]
  invoiceSettings     InvoiceSettings?
  loans               Loan[]
  products            Product[]
  sales               Sale[]
  secondHandRecords   SecondHandRecord[]
  suppliers           Supplier[]
  transactions        Transaction[]
  users               User[]
  stockMovements      StockMovement[]
  accounts            Account[]
  journalEntries      JournalEntry[]
  branches            Branch[]
  subscription              Subscription?
  subscriptionRequests      SubscriptionRequest[]
  subscriptionAuditLogs     SubscriptionAuditLog[]
  notifications             Notification[]
}

model InvoiceSettings {
  id        String   @id @default(uuid())
  storeId   String   @unique
  general   String   @default("{}")
  layout    String   @default("{}")
  products  String   @default("{}")
  payment   String   @default("{}")
  footer    String   @default("{}")
  print     String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  username  String
  password  String
  name      String
  role      Role     @default(CASHIER)
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@unique([username, storeId])
  @@index([storeId])
}

model Product {
  id        String           @id @default(uuid())
  name      String
  barcode   String?
  model     String
  brand     String
  category  String
  price     Decimal
  cost      Decimal
  profit    Decimal          @default(0)
  stock    Int              @default(0)
  minStock  Int              @default(5)
  storage   String?
  color    String?
  imei     String?
  warranty Int?
  metadata Json?
  storeId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  store     Store            @relation(fields: [storeId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  saleItems      SaleItem[]
  exchangeItems  ExchangeItem[]
  stockMovements StockMovement[]

  @@unique([barcode, storeId])
  @@index([storeId])
  @@index([storeId, category])
  @@index([barcode])
  @@index([storeId, stock])
  @@index([storeId, minStock])
  @@index([deletedAt])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String?
  dueAmount Decimal  @default(0)
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  store     Store    @relation(fields: [storeId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  sales     Sale[]

  @@unique([phone, storeId])
  @@index([storeId])
  @@index([deletedAt])
}

model Sale {
  id               String     @id @default(uuid())
  invoiceId        String
  saleType         String     @default("REGULAR")
  totalAmount      Decimal
  paidAmount       Decimal
  dueAmount        Decimal
  discount         Decimal    @default(0)
  costAmount       Decimal    @default(0)
  profit           Decimal    @default(0)
  status           SaleStatus
  customerId       String?
  customerName     String?    @default("Walking Customer")
  storeId          String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deliveryDate     DateTime?
  dueDate          DateTime?  // Expected payment date for due sales
  refundedAmount   Decimal    @default(0)
  advanceAmount    Decimal?   // Advance paid amount for advance orders
  payments         Payment[]
  store            Store      @relation(fields: [storeId], references: [id])
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id])
  customer         Customer?  @relation(fields: [customerId], references: [id])
  items            SaleItem[]
  exchangeItems    ExchangeItem[]
  emiSchedules     EMISchedule[]

  // EMI fields (null for non-EMI sales)
  emiMonths       Int?
  interestRate    Decimal?   @db.Decimal(5, 2)
  downPayment     Decimal?   @db.Decimal(10, 2)
  monthlyAmount   Decimal?   @db.Decimal(10, 2)

  // Online sale fields
  platform        String?
  courier         String?
  trackingNumber  String?

  @@unique([invoiceId, storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([storeId, saleType])
  @@index([dueDate])
  @@index([storeId, dueAmount])
}

model EMISchedule {
  id            String   @id @default(cuid())
  saleId        String
  installmentNo Int
  dueDate       DateTime
  amount        Decimal  @db.Decimal(10, 2)
  status        String   @default("PENDING")
  paidDate      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([status])
  @@index([dueDate])
}

model SaleItem {
  id                String           @id @default(uuid())
  saleId            String
  productId         String
  quantity          Int
  price             Decimal
  cost              Decimal?
  profit            Decimal          @default(0)
  returnedQuantity  Int              @default(0)
  returnReason      String?
  imeis             String?          // JSON array of IMEI/serial numbers
  product           Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  sale              Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([saleId])
}

model ExchangeItem {
  id             String   @id @default(cuid())
  saleId         String
   sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  description    String
  estimatedValue Float
  condition      String   @default("good")
  createdAt      DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(uuid())
  amount    Decimal
  method    String
  status    PaymentStatus @default(ACTIVE)
  date      DateTime      @default(now())
  saleId    String?
  customerId String?
  userId    String?
  storeId   String
  createdAt DateTime      @default(now())
  sale      Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@index([saleId])
  @@index([customerId])
  @@index([userId])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  category    String
  date        DateTime @default(now())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([storeId, date])
}

model Loan {
  id           String        @id @default(uuid())
  borrower     String
  type         String
  amount       Decimal
  paid         Decimal       @default(0)
  remaining    Decimal
  date         DateTime      @default(now())
  storeId      String
  store         Store         @relation(fields: [storeId], references: [id])
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  transactions Transaction[]

  @@index([storeId, type])
}

model Supplier {
  id            String              @id @default(uuid())
  name          String
  phone         String?
  address      String?
  dueAmount    Decimal             @default(0)
  storeId      String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  store        Store               @relation(fields: [storeId], references: [id])
  transactions Transaction[]
  products     SupplierProduct[]

  @@index([storeId])
  @@index([phone])
  @@index([deletedAt])
}

model SupplierProduct {
  id           String   @id @default(uuid())
  supplierId  String
  productId  String?
  productName String  // For existing products or custom names
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  
  @@unique([supplierId, productName])
}

model DailyBalance {
  id            String   @id @default(uuid())
  date          DateTime
  openingCash   Decimal  @default(0)
  closingCash   Decimal  @default(0)
  expectedCash  Decimal  @default(0)
  cashSales     Decimal  @default(0)
  bankDeposits  Decimal  @default(0)
  totalExpenses Decimal  @default(0)
  totalDuePaid  Decimal  @default(0)
  totalPurchases Decimal @default(0)
  isLocked      Boolean  @default(false)
  lockedAt      DateTime?
  storeId       String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, date])
  @@index([storeId, isLocked])
}

model Event {
  id            String   @id @default(uuid())
  aggregateType String
  aggregateId   String
  type          String
  payload       String
  metadata      String?
  userId        String?
  storeId       String
  createdAt     DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id])

  @@unique([aggregateType, aggregateId, createdAt])
  @@index([storeId, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String
  response  String
  status    String   @default("COMPLETED")
  storeId   String
  createdAt DateTime @default(now())

  @@unique([key, storeId])
  @@index([storeId])
  @@index([createdAt])
}

model Transaction {
  id            String            @id @default(uuid())
  type          TransactionType
  amount        Decimal
  costAmount    Decimal?
  profit        Decimal           @default(0)
  mode          TransactionMode   @default(CASH)
  referenceId   String?
  referenceType String?
  description   String?
  barcode       String?
  productId     String?
  customerId    String?
  supplierId    String?
  userId        String?
  storeId       String
  loanId        String?
  createdAt     DateTime          @default(now())
  status        TransactionStatus @default(COMPLETED)
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  loan          Loan?             @relation(fields: [loanId], references: [id])
  store         Store             @relation(fields: [storeId], references: [id])
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])

  @@index([storeId, type, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, mode, createdAt])
  @@index([barcode])
}

model Account {
  id            String        @id @default(uuid())
  code          String
  name          String
  type          String        // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  isSystem      Boolean       @default(false)
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  createdAt     DateTime      @default(now())
  journalLines  JournalLine[]

  @@unique([code, storeId])
  @@index([storeId])
}

model JournalEntry {
  id            String        @id @default(uuid())
  date          DateTime
  description   String
  referenceId   String?
  referenceType String?
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  createdAt     DateTime      @default(now())
  lines         JournalLine[]

  @@index([storeId, date])
  @@index([referenceId])
}

model JournalLine {
  id             String        @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id])
  debit          Decimal       @default(0)
  credit         Decimal       @default(0)

  @@index([journalEntryId])
  @@index([accountId])
}

model SecondHandRecord {
  id            String   @id @default(uuid())
  sellerName    String
  fatherName    String?
  nidNumber     String
  phone         String?
  imei          String?
  nidPhotoData  Bytes?
  nidPhotoHash  String?
  model         String
  purchasePrice Decimal
  date          DateTime @default(now())
  storeId       String
  isImmutable   Boolean  @default(true)
  encryptionIv  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@unique([storeId, nidNumber])
  @@index([storeId, createdAt])
}

model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantityChange Int
  stockBefore   Int
  stockAfter    Int
  reason        String
  referenceId   String?
  referenceType String?
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([storeId, createdAt])
  @@index([referenceId])
}

model BarcodeSettings {
  id              String   @id @default(uuid())
  storeId         String   @unique
  barcodeType     String   @default("CODE128")
  labelWidth      Int      @default(38)
  labelHeight     Int      @default(25)
  labelSizeName   String   @default("38x25mm")
  showProductName Boolean  @default(true)
  showPrice       Boolean  @default(true)
  showSku         Boolean  @default(true)
  showBarcode     Boolean  @default(true)
  showQrCode      Boolean  @default(false)
  showWarranty    Boolean  @default(false)
  includeCurrency Boolean  @default(true)
  fontSize        Int      @default(8)
  compactMode     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  store           Store    @relation(fields: [storeId], references: [id])
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum SaleStatus {
  PAID       // Full cash / instant-payment sale
  PARTIAL    // Customer still owes; has paid something
  DUE        // Pure credit sale; nothing collected yet
  PENDING    // Advance order: customer has paid deposit, not yet collected
  COMPLETED  // Advance order: customer collected goods; stock decremented here
  CANCELLED  // Sale voided (refunded, wrong entry, etc.)
}

enum SaleType {
  REGULAR
  ADVANCE_ORDER
  DUE
  EMI
  ONLINE
  EXCHANGE
  SECOND_HAND
  REPAIR
  WHOLESALE
}

enum TransactionType {
  SALE
  SALE_REFUND
  PURCHASE
  PURCHASE_RETURN
  DUE_PAYMENT
  HAWLAT_GIVEN
  HAWLAT_RECEIVED
  EXPENSE
  STOCK_IN
  SECONDHAND_BUY
  OPENING
  CLOSING
}

enum TransactionMode {
  CASH
  BANK
  BKASH
  NAGAD
  CARD
  DUE
}

enum PaymentStatus {
  ACTIVE
  REFUNDED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionAuditAction {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  EXPIRED
  GRACE_PERIOD_START
  CANCELLED
  RENEWED
}

enum NotificationType {
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_APPROVED
  SUBSCRIPTION_REJECTED
  PAYMENT_RECEIVED
  GRACE_PERIOD_STARTING
}
