generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  customers Customer[]
  products  Product[]
  users     User[]
  transactions Transaction[]
  expenses  Expense[]
  loans     Loan[]
  secondHandRecords SecondHandRecord[]

  @@unique([name, storeId])
  @@index([storeId])
}

model Store {
  id                String             @id @default(uuid())
  name              String
  address           String?
  phone             String?
  email             String?
  description       String?
  logo              String?
  invoicePrefix     String             @default("INV")
  invoiceCode       String             @default("")
  invoiceNumbering  Int                @default(1)
  currency          String             @default("BDT")
  dateFormat        String             @default("DD/MM/YYYY")
  timezone          String             @default("Asia/Dhaka")
  language          String             @default("bn")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  barcodeSettings   BarcodeSettings?
  customers         Customer[]
  dailyBalances     DailyBalance[]
  events            Event[]
  expenses          Expense[]
  invoiceSettings   InvoiceSettings?
  loans             Loan[]
  products          Product[]
  sales             Sale[]
  secondHandRecords SecondHandRecord[]
  suppliers         Supplier[]
  transactions      Transaction[]
  users             User[]
  stockMovements    StockMovement[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  branches          Branch[]
}

model InvoiceSettings {
  id            String   @id @default(uuid())
  showLogo      Boolean  @default(true)
  showBarcode   Boolean  @default(true)
  showSignature Boolean  @default(true)
  footerText    String?
  storeId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BarcodeSettings {
  id            String   @id @default(uuid())
  width         Int      @default(50)
  height        Int      @default(30)
  label         String   @default("")
  showPrice     Boolean  @default(true)
  showProduct   Boolean  @default(true)
  margin        Int      @default(5)
  storeId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CASHIER)
  isActive  Boolean  @default(true)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum SaleStatus {
  PAID
  DUE
  PARTIAL
  PENDING
  COMPLETED
  CANCELLED
}

enum TransactionMode {
  CASH
  BANK
  BKASH
  NAGAD
  CARD
  DUE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum PaymentStatus {
  ACTIVE
  REFUNDED
}

model Product {
  id              String       @id @default(uuid())
  name            String
  brand           String       @default("")
  model           String       @default("")
  category        String       @default("SMARTPHONE")
  price           Decimal
  cost            Decimal      @default(0)
  stock           Int          @default(0)
  minStock        Int          @default(5)
  barcode         String       @default("")
  storage         String?
  color           String?
  imei            String?
  warranty        String       @default("")
  storeId         String
  store           Store        @relation(fields: [storeId], references: [id])
  branchId        String?
  branch          Branch?      @relation(fields: [branchId], references: [id])
  saleItems       SaleItem[]
  supplierLinks   SupplierProduct[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  stockMovements  StockMovement[]

  @@unique([barcode, storeId])
  @@index([storeId, category])
  @@index([storeId, name])
}

model Supplier {
  id            String            @id @default(uuid())
  name          String
  phone         String?
  address       String?
  dueAmount     Decimal           @default(0)
  storeId       String
  store         Store             @relation(fields: [storeId], references: [id])
  products      SupplierProduct[]
  transactions  Transaction[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([storeId])
}

model SupplierProduct {
  id          String    @id @default(uuid())
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  productName String

  @@unique([supplierId, productName])
  @@index([supplierId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  dueAmount Decimal  @default(0)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  sales     Sale[]
  payments  Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, storeId])
  @@index([storeId])
}

model Sale {
  id               String     @id @default(uuid())
  invoiceId        String
  saleType         String     @default("REGULAR")
  totalAmount      Decimal
  paidAmount       Decimal
  dueAmount        Decimal
  discount         Decimal    @default(0)
  costAmount       Decimal    @default(0)
  profit           Decimal    @default(0)
  status           SaleStatus
  customerId       String?
  customerName     String?    @default("Walking Customer")
  refundedAmount   Decimal    @default(0)
  storeId          String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deliveryDate     DateTime?
  dueDate          DateTime?
  advanceAmount    Decimal?
  payments         Payment[]
  store            Store      @relation(fields: [storeId], references: [id])
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  customer         Customer?  @relation(fields: [customerId], references: [id])
  items            SaleItem[]

  @@unique([invoiceId, storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([storeId, saleType])
  @@index([dueDate])
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id])
  quantity  Int
  price     Decimal
  cost      Decimal  @default(0)
  profit    Decimal  @default(0)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id         String          @id @default(uuid())
  saleId     String?
  customerId String?
  amount     Decimal
  method     TransactionMode @default(CASH)
  date       DateTime        @default(now())
  status     PaymentStatus   @default(ACTIVE)
  sale       Sale?           @relation(fields: [saleId], references: [id])
  customer   Customer?       @relation(fields: [customerId], references: [id])
  storeId    String

  @@index([saleId])
  @@index([storeId, date])
  @@index([customerId])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  category    String?
  date        DateTime @default(now())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())

  @@index([storeId, date])
}

model Loan {
  id        String   @id @default(uuid())
  borrower  String
  type      String   @default("GIVE")
  amount    Decimal
  paid      Decimal  @default(0)
  remaining Decimal
  date      DateTime @default(now())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model DailyBalance {
  id           String   @id @default(uuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  date         DateTime
  openingCash  Decimal  @default(0)
  closingCash  Decimal  @default(0)
  expectedCash Decimal  @default(0)
  notes        String   @default("")
  isLocked     Boolean  @default(false)
  lockedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, date])
  @@index([storeId])
}

model Event {
  id            String          @id @default(uuid())
  aggregateType String
  aggregateId   String
  type          String
  payload       Json
  metadata      Json?
  userId        String?
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([storeId, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([aggregateType])
}

model Transaction {
  id            String             @id @default(uuid())
  type          String
  amount        Decimal
  costAmount    Decimal?
  profit        Decimal?
  mode          TransactionMode    @default(CASH)
  description   String?
  referenceId   String?
  referenceType String?
  barcode       String?
  productId     String?
  customerId    String?
  supplierId    String?
  userId        String?
  storeId       String
  loanId        String?
  createdAt     DateTime           @default(now())
  status        TransactionStatus  @default(COMPLETED)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  loan          Loan?              @relation(fields: [loanId], references: [id])
  store         Store              @relation(fields: [storeId], references: [id])
  branchId      String?
  branch        Branch?            @relation(fields: [branchId], references: [id])

  @@index([storeId, type, createdAt])
  @@index([storeId, createdAt])
  @@index([barcode])
}

model SecondHandRecord {
  id            String   @id @default(uuid())
  sellerName    String
  fatherName    String?
  nidNumber     String
  nidPhotoData  Bytes?
  nidPhotoHash  String?
  model         String
  purchasePrice Decimal
  date          DateTime @default(now())
  storeId       String
  branchId      String?
  isImmutable   Boolean  @default(true)
  encryptionIv  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id])
  branch        Branch?  @relation(fields: [branchId], references: [id])
}

model StockMovement {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  reason         String
  referenceId    String?
  referenceType  String?
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([storeId, createdAt])
  @@index([referenceId])
}

model Account {
  id            String        @id @default(uuid())
  code          String
  name          String
  type          String
  isSystem      Boolean       @default(false)
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  createdAt     DateTime      @default(now())
  journalLines  JournalLine[]

  @@unique([code, storeId])
  @@index([storeId])
}

model JournalEntry {
  id            String        @id @default(uuid())
  date          DateTime
  description   String
  referenceId   String?
  referenceType String?
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  createdAt     DateTime      @default(now())
  lines         JournalLine[]

  @@index([storeId, date])
  @@index([referenceId])
}

model JournalLine {
  id             String        @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id])
  debit          Decimal       @default(0)
  credit         Decimal       @default(0)

  @@index([journalEntryId])
  @@index([accountId])
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String
  storeId   String
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([key, storeId])
}

model AccountSession {
  id        String   @id @default(uuid())
  userId    String
  name      String?
  type      String   @default("USER")
  expiresAt DateTime
  createdAt DateTime @default(now())
}
